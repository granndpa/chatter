# Sourced before building a binary people download: `source scripts/release-env
# TARGET`, then plain `cargo build --target TARGET`. Rust embeds source paths for panic messages, and C's __FILE__ ends
# up in error messages too; they'd name the folders of the machine that built
# it, its owner's home folder among them. These flags name none.
# CARGO_ENCODED_RUSTFLAGS replaces .cargo/config.toml's rustflags, so a
# target's own come along here.
static_release_target=${1:?usage: source scripts/release-env TARGET}
static_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
# Widest first: rustc and Clang take the last mapping that matches.
static_maps=("$HOME=/home" "${CARGO_HOME:-$HOME/.cargo}=/cargo" "$static_root=/static")
static_rust=()
static_c=()
for map in "${static_maps[@]}"; do
  static_rust+=("--remap-path-prefix=$map")
  static_c+=("-ffile-prefix-map=$map")
done
case "$static_release_target" in
  x86_64-pc-windows-msvc)
    # Match LiveKit's Windows runtime linkage, as .cargo/config.toml does.
    static_rust=(-Ctarget-feature=+crt-static "${static_rust[@]}")
    # cargo-xwin compiles C with clang-cl, which takes Clang's flags this way.
    static_c=("${static_c[@]/#//clang:}") ;;
  x86_64-unknown-linux-gnu) ;;
  *) echo "scripts/release-env: no flags known for $static_release_target" >&2; return 2 ;;
esac
CARGO_ENCODED_RUSTFLAGS=$(IFS=$'\x1f'; printf '%s' "${static_rust[*]}")
export CARGO_ENCODED_RUSTFLAGS
# The cc crate reads only the first of CFLAGS_<target> and its fallbacks, and
# `cargo xwin build` sets that one, so take its environment, which adds to
# these rustflags, and add the C flags to what it sets.
static_target_flags=${static_release_target//-/_}
if [[ "$static_release_target" == *-windows-msvc ]]; then
  eval "$(cargo xwin env --target "$static_release_target")"
  # thorvg-sys tells bindgen's libclang `--target=x86_64-none-elf` on every
  # cross build, which can't read the MSVC headers. bindgen adds these
  # arguments after a build script's, and Clang takes the last target.
  static_bindgen="BINDGEN_EXTRA_CLANG_ARGS_$static_target_flags"
  export "$static_bindgen=${!static_bindgen:-} --target=$static_release_target"
fi
static_cflags="CFLAGS_$static_target_flags" static_cxxflags="CXXFLAGS_$static_target_flags"
export "$static_cflags=${!static_cflags:-} ${static_c[*]}"
export "$static_cxxflags=${!static_cxxflags:-} ${static_c[*]}"
unset static_release_target static_root static_maps static_rust static_c map \
  static_target_flags static_cflags static_cxxflags static_bindgen
