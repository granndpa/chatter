// Static's icon, which Explorer shows for static.exe and its shortcuts, and the
// window loads by its number (src/icon.rs). scripts/make-windows-icon draws it.
1 ICON "static.ico"
1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Static\0"
            VALUE "FileDescription", "Static desktop client\0"
            VALUE "FileVersion", "0.3.0\0"
            VALUE "OriginalFilename", "static.exe\0"
            VALUE "ProductName", "Static\0"
            VALUE "ProductVersion", "0.3.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
