<?xml version="1.0" encoding="UTF-8"?>
<!-- What software centers and AppImage catalogs show for Chatter. -->
<component type="desktop-application">
  <id>io.github.yapfast.Yapfast</id>
  <name>Chatter</name>
  <summary>A Discord client without the web browser</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <developer id="io.github.static">
    <name>wiredtenshi</name>
  </developer>
  <description>
    <p>
      Chatter talks to Discord's API itself and draws its own window with Slint
      and Skia, so it runs in about 30 MB of RAM, where Discord's own app takes 720.
    </p>
    <p>
      Servers, DMs, threads, forums, friends, voice, screen sharing and GIFs are
      all there, laid out the way Discord lays them out.
    </p>
  </description>
  <launchable type="desktop-id">io.github.yapfast.Yapfast.desktop</launchable>
  <url type="homepage">https://yapfast.com</url>
  <url type="bugtracker">https://github.com/yapfast/chatter-desktop/issues</url>
  <url type="vcs-browser">https://github.com/yapfast/chatter-desktop</url>
  <categories>
    <category>Network</category>
    <category>InstantMessaging</category>
  </categories>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
    <content_attribute id="social-audio">intense</content_attribute>
    <content_attribute id="social-contacts">intense</content_attribute>
  </content_rating>
  <releases>
