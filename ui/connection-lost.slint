// The screen while Chatter's connection is lost: the logo's little white
// character looks around, tilts its head, blinks, gets sleepy, wakes up
// with a hop, and starts over, in a 4.8 second loop.

import { Theme } from "theme.slint";

/// The character, drawn from the logo's parts: the purple back bubble, the
/// white front bubble, and its two eyes.
component Character inherits Rectangle {
    /// Where in the loop it is, from 0 to 1.
    in property <float> t;
    in property <length> size: 150px;
    // 0 to 1 between `a` and `b` along the loop, eased in and out.
    pure function ease(a: float, b: float) -> float {
        let x = max(0, min(1, (root.t - a) / (b - a)));
        (1 - Math.cos(x * 180deg)) / 2
    }
    // Up from 0 to 1 at `peak` and back down, between `a` and `c`.
    pure function bump(a: float, peak: float, c: float) -> float {
        self.ease(a, peak) - self.ease(peak, c)
    }
    // Eyes: left (-1), right (+1), then ahead.
    property <float> look: -self.ease(0.00, 0.08) + 2 * self.ease(0.16, 0.24) - self.ease(0.30, 0.36);
    // A head tilt while it wonders, a little more while it nods off.
    property <angle> tilt: (8 * (self.ease(0.36, 0.42) - self.ease(0.80, 0.86)) + 5 * (self.ease(0.55, 0.75) - self.ease(0.80, 0.86))) * 1deg;
    // How open its eyes are: a quick blink, then slowly closing, then awake.
    property <float> open: (1 - 0.9 * self.bump(0.45, 0.475, 0.50)) * (1 - 0.92 * (self.ease(0.55, 0.76) - self.ease(0.80, 0.82)));
    // Squash as it wakes, stretch as it hops, and a slow breath throughout.
    property <float> squash: self.bump(0.80, 0.83, 0.86);
    property <float> stretch: self.bump(0.86, 0.90, 0.96);
    property <float> breath: Math.sin(root.t * 720deg) * 0.02;
    property <float> scale-y: 1 - 0.14 * self.squash + 0.10 * self.stretch + self.breath;
    property <float> scale-x: 1 + 0.12 * self.squash - 0.07 * self.stretch - self.breath * 0.5;
    property <length> hop: -14px * self.stretch;
    width: root.size; height: root.size * 560 / 600;
    // The body, squashed and stretched from its feet.
    body := Rectangle {
        width: root.width * root.scale-x; height: root.height * root.scale-y;
        x: (root.width - self.width) / 2; y: root.height - self.height + root.hop;
        property <float> kx: self.width / 600px;
        property <float> ky: self.height / 560px;
        // The back bubble trails a moment behind.
        Image {
            width: parent.width; height: parent.height;
            y: 3px * Math.sin(root.t * 360deg - 40deg) + 4px * root.stretch;
            source: @image-url("icons/chatter-back.svg"); image-fit: fill;
            accessible-role: none;
        }
        Image {
            width: parent.width; height: parent.height;
            source: @image-url("icons/chatter-face.svg"); image-fit: fill;
            transform-rotation: root.tilt;
            transform-origin: { x: self.width * 0.45, y: self.height * 0.75 };
            accessible-role: none;
        }
        for eye in [{ x: 169, width: 62, image: @image-url("icons/chatter-eye-left.svg") }, { x: 293, width: 61, image: @image-url("icons/chatter-eye-right.svg") }]: Image {
            property <length> full-height: 94px * parent.ky;
            width: eye.width * 1px * parent.kx;
            height: max(2px, self.full-height * root.open);
            x: eye.x * 1px * parent.kx + root.look * 16px * parent.kx;
            y: 154px * parent.ky + (self.full-height - self.height) * 0.6;
            source: eye.image; image-fit: fill;
            // Turns with the head, around the same point.
            transform-rotation: root.tilt;
            transform-origin: { x: parent.width * 0.45 - self.x, y: parent.height * 0.75 - self.y };
            accessible-role: none;
        }
    }
    // A soft shadow that shrinks as it hops.
    Rectangle {
        width: root.width * 0.55 * (1 - 0.3 * root.stretch) * root.scale-x; height: 8px;
        x: (root.width - self.width) / 2; y: root.height + 6px;
        border-radius: 4px; background: #00000040;
    }
}

/// Covers the window while the connection is down; the rest of Chatter comes
/// back as it was once it reconnects.
export component ConnectionLost inherits Rectangle {
    property <float> t: Math.mod(animation-tick() / 1ms, 4800) / 4800;
    background: Theme.chat;
    accessible-role: groupbox;
    accessible-label: "Connection lost. Trying to reconnect.";
    // Swallows clicks meant for what's underneath.
    TouchArea { }
    VerticalLayout {
        alignment: center; spacing: 18px;
        HorizontalLayout {
            alignment: center;
            Character { t: root.t; size: 150px; }
        }
        Rectangle { height: 6px; }
        Text { text: "Connection lost"; color: Theme.text; font-size: 22px; font-weight: 700; horizontal-alignment: center; }
        Text {
            text: "Trying to reconnect...";
            color: Theme.muted; font-size: 15px; horizontal-alignment: center;
        }
    }
}
