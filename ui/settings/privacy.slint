import { Theme, Middle, Label } from "../theme.slint";
import { ActionButton, Avatar } from "../controls.slint";
import { SettingsTitle, SettingsHeading, SettingsSwitch, BlockedRow } from "../settings.slint";
import { RadioOption } from "radio.slint";

// A line above a group, as between Discord's sections.
component Divider inherits Rectangle { height: 1px; background: Theme.line; }

// Settings: whether Discord may use the account's data, as its Data & Privacy
// page asks. Discord keeps these for the account, on every device.
export component DataPrivacySettings inherits VerticalLayout {
    /// The account's settings have come from Discord.
    in property <bool> loaded;
    in property <bool> usage-statistics;
    in property <bool> personalization;
    /// Change a consent: `usage_statistics` or `personalization`.
    callback consent-changed(string, bool);
    spacing: 16px;
    SettingsTitle { text: "Data & Privacy"; }
    SettingsHeading { text: "How Discord Uses Your Data"; }
    Label { text: "Discord always keeps what it needs to run your account, such as your messages, servers and DMs. These choose what else it may do with your data, for this account on every device."; }
    if !root.loaded: Label { text: "Loading your settings from Discord..."; }
    if root.loaded: SettingsSwitch {
        text: "Use data to improve Discord";
        description: "Lets Discord use and process your information to understand and improve its services.";
        controlled: true; checked: root.usage-statistics;
        toggled(on) => { root.consent-changed("usage_statistics", on); }
    }
    if root.loaded: SettingsSwitch {
        text: "Use data to personalise my Discord experience";
        description: "Lets Discord use things like who you talk to and what games you play to personalise Discord for you.";
        controlled: true; checked: root.personalization;
        toggled(on) => { root.consent-changed("personalization", on); }
    }
    Divider { }
    SettingsHeading { text: "Chatter"; }
    Label { text: "Chatter sends nothing to anyone but Discord: no analytics, crash reports or update checks. Your login stays in Windows' credential store on this computer."; }
}

// Settings: who may message and befriend the account, its spam filter, and
// the people it blocked, as Discord's Messaging Permissions page has them.
export component MessagingSettings inherits VerticalLayout {
    in property <bool> loaded;
    in property <bool> dms-from-servers;
    /// Discord's flags: 2 friends of friends, 4 server members, 8 everyone.
    in property <int> friend-sources;
    /// 1 off, 2 from non-friends, 3 everyone.
    in property <int> spam-filter;
    in property <bool> hide-blocked;
    in property <[BlockedRow]> blocked;
    /// Change a permission: `dms`, `friends` or `spam`, to a value as above;
    /// `dms` is 1 for allowed.
    callback changed(string, int);
    callback hide-blocked-toggled(bool);
    /// Unblock someone, by user id.
    callback unblock(string);
    /// How many of them show; Discord's list shows five more at a time.
    private property <int> blocked-shown: 5;
    private property <bool> from-friends-of-friends: Math.mod(Math.floor(root.friend-sources / 2), 2) == 1;
    private property <bool> from-server-members: Math.mod(Math.floor(root.friend-sources / 4), 2) == 1;
    private property <bool> from-everyone: root.friend-sources >= 8;
    spacing: 16px;
    SettingsTitle { text: "Messaging Permissions"; }
    if !root.loaded: Label { text: "Loading your settings from Discord..."; }
    if root.loaded: VerticalLayout {
        spacing: 4px;
        SettingsHeading { text: "Spam Filter"; }
        Label { text: "Discord can filter out messages that look like spam. They go to your Spam inbox."; }
        RadioOption {
            text: "Filter all spam"; checked: root.spam-filter == 3;
            clicked => { root.changed("spam", 3); }
        }
        RadioOption {
            text: "Filter messages from non-friends"; description: "Recommended";
            checked: root.spam-filter == 2;
            clicked => { root.changed("spam", 2); }
        }
        RadioOption {
            text: "Don't filter spam"; checked: root.spam-filter == 1;
            clicked => { root.changed("spam", 1); }
        }
    }
    if root.loaded: Divider { }
    if root.loaded: VerticalLayout {
        spacing: 12px;
        SettingsHeading { text: "Direct Messages"; }
        SettingsSwitch {
            text: "Allow DMs from other server members";
            description: "People who share a server with you can message you. Friends always can.";
            controlled: true; checked: root.dms-from-servers;
            toggled(on) => { root.changed("dms", on ? 1 : 0); }
        }
    }
    if root.loaded: Divider { }
    if root.loaded: VerticalLayout {
        spacing: 12px;
        SettingsHeading { text: "Allow Friend Requests from"; }
        SettingsSwitch {
            text: "Everyone"; controlled: true; checked: root.from-everyone;
            toggled(on) => { root.changed("friends", on ? 8 : 6); }
        }
        SettingsSwitch {
            text: "Friends of friends"; controlled: true; checked: root.from-friends-of-friends;
            toggled(on) => { root.changed("friends", (on ? 2 : 0) + (root.from-server-members ? 4 : 0)); }
        }
        SettingsSwitch {
            text: "Server members";
            description: "Only from servers where you also allow DMs.";
            controlled: true; checked: root.from-server-members;
            toggled(on) => { root.changed("friends", (root.from-friends-of-friends ? 2 : 0) + (on ? 4 : 0)); }
        }
    }
    Divider { }
    SettingsHeading { text: "Ignore & Block"; }
    SettingsSwitch {
        text: "Hide messages from people you blocked";
        description: "Leaves them out entirely, rather than showing a line you can open.";
        controlled: true; checked: root.hide-blocked;
        toggled(hide) => { root.hide-blocked-toggled(hide); }
    }
    if root.blocked.length == 0: Label { text: "You haven't blocked anyone."; }
    if root.blocked.length > 0: VerticalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px; padding-top: 8px;
            Middle {
                Rectangle {
                    width: 40px; height: 40px; border-radius: 20px; background: Theme.raised;
                    Image { source: @image-url("../icons/ban.svg"); width: 20px; height: 20px; colorize: Theme.secondary; }
                }
            }
            VerticalLayout {
                alignment: center; spacing: 2px;
                Text { text: "Blocked accounts"; color: Theme.text; font-size: 16px; font-weight: 600; }
                Text { text: root.blocked.length + (root.blocked.length == 1 ? " account" : " accounts"); color: Theme.secondary; font-size: 14px; }
            }
        }
        VerticalLayout {
            for person[index] in root.blocked: VerticalLayout {
                if index < root.blocked-shown: HorizontalLayout {
                    padding-top: 6px; padding-bottom: 6px; spacing: 12px;
                    Middle { Avatar { size: 40px; initial: person.initial; picture-url: person.avatar-url; } }
                    Middle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: person.name; color: Theme.text; font-size: 16px; font-weight: 600; overflow: elide; }
                            if person.username != "": Text { text: person.username; color: Theme.secondary; font-size: 14px; overflow: elide; }
                        }
                    }
                    Middle {
                        ActionButton {
                            text: "Unblock"; small: true; label: "Unblock " + person.name;
                            clicked => { root.unblock(person.id); }
                        }
                    }
                }
            }
        }
        if root.blocked.length > root.blocked-shown: HorizontalLayout {
            alignment: start;
            ActionButton {
                text: "See " + (root.blocked.length - root.blocked-shown) + " more"; ghost: true; small: true;
                clicked => { root.blocked-shown += 5; }
            }
        }
    }
}
